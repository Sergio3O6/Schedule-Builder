{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // "node" is here so scripts/ typechecks. The normalizer is written in TS
    // specifically so it can import src/domain and have a schema change break the
    // build; that only holds if tsc actually reads it (see "include" below).
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    // scripts/ runs under Node 24's native type-stripping, and ESM there needs a
    // full specifier — `./request.ts`, not `./request`. Legal only because we
    // never emit (noEmit below); tsc would otherwise write imports it can't fix.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // "scripts" covers the crawler and normalizer. It has no files yet — tsc ignores
  // a non-matching entry as long as some other entry matches — but it must be here
  // before commit 2 writes into it, or the Node code lands untypechecked.
  "include": ["src", "scripts", "vite.config.ts", "vitest.setup.ts"]
}
